---
- name: Update LDAP password in IBMLDAPSecurity.ini
  hosts: all
  become: yes
  vars:
    ldap_file: "/db2home/ebihost/sqllib/cfg/IBMLDAPSecurity.ini"
    new_password: "{{ new_password }}"
  tasks:
    - name: Get the today date in MMDDYYYY format
      command: date +"%m%d%y"
      register: current_date
      changed_when: false
      
    - name: Take backup of IBMLDAPSecurity.ini 
      copy:
        src: "{{ ldap_file }}"
        dest: "{{ ldap_file }}_{{ current_date }}"
        remote_src: yes
        
    - name: Replace the LDAP password in file
      lineinfile:
        path: "{{ ldap_file }}"
        regexp: '^SEARCH_PW=.*'
        line: SEARCH_PW={{ new_password }}
        
